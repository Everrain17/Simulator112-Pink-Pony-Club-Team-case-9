# --- runtime ---
SERVER_HOST=127.0.0.1
SERVER_PORT=8010
SIMCORE_URL=http://127.0.0.1:5000
SIMCORE_INTERNAL_TOKEN=system112-dev-internal
SIMCORE_TIMEOUT_SEC=45
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# --- app ---
DEBUG=true

# --- postgres ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=trainer
POSTGRES_PASSWORD=trainer
POSTGRES_DB=trainer

# --- redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- jwt ---
JWT_SECRET=change-me
JWT_ALG=HS256
JWT_ACCESS_EXP_MIN=15
JWT_REFRESH_EXP_DAYS=7

# --- TLS базовый ---
SSL_ENABLED=false
SSL_CERT_FILE=certs/server.crt
SSL_KEY_FILE=certs/server.key
SSL_CA_FILE=certs/ca.crt

# Минимальная версия: "1.2" (по умолчанию) или "1.3".
SSL_MIN_TLS_VERSION=1.2

# --- mTLS (опционально, но рекомендуется в проде) ---
# Включать после того, как все рабочие места получат клиентский
# сертификат (см. backend/scripts/generate_client_cert.py).
SSL_VERIFY_CLIENT=false
SSL_CLIENT_CERT_FILE=certs/client.crt
SSL_CLIENT_KEY_FILE=certs/client.key
